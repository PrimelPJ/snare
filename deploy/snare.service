[Unit]
Description=Snare honeypot and live threat map
After=network-online.target
Wants=network-online.target

[Service]
User=snare
Group=snare
EnvironmentFile=/etc/snare/snare.env
ExecStart=/opt/snare/venv/bin/python -m snare run
Restart=always
RestartSec=5

# Bind ports 22, 23, 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Lock it down. The process only needs to write its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/snare
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
MemoryMax=512M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
