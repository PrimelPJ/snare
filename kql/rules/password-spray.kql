// Spraying: one IP tries many usernames with only a few passwords.
HoneypotEvents_CL
| where Kind == "login_attempt"
| summarize Usernames = dcount(Username), Passwords = dcount(Password), Attempts = count(),
            SampleUsers = make_set(Username, 10), Country = take_any(Country)
    by SrcIp
| where Usernames >= 10 and Passwords <= 3
